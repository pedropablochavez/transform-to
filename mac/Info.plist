	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>NSHighResolutionCapable</key>
	<true/>

	<!-- The "Transform to…" item in Finder's right-click menu (Quick Actions / Services). -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
