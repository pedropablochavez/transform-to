<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>TransformTo</AssemblyName>
    <Product>Transform To</Product>
    <Version>1.0.0</Version>
    <Authors>pedropablochavez</Authors>
    <Description>Right-click any file and transform it to another format.</Description>
  </PropertyGroup>

  <!-- `dotnet publish` produces a single self-contained TransformTo.exe (no .NET install needed). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-x64" Version="15.0.0" />
  </ItemGroup>

  <!-- Windows 11 main-menu pieces, produced by windows/ShellExtension/build.ps1. Builds without them fall back to
       the classic menu. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\build\shell\TransformToShell.dll" LogicalName="TransformToShell.dll" Condition="Exists('..\..\build\shell\TransformToShell.dll')" />
    <EmbeddedResource Include="..\..\build\shell\TransformTo.msix" LogicalName="TransformTo.msix" Condition="Exists('..\..\build\shell\TransformTo.msix')" />
    <EmbeddedResource Include="..\..\build\shell\TransformTo.cer" LogicalName="TransformTo.cer" Condition="Exists('..\..\build\shell\TransformTo.cer')" />
  </ItemGroup>

</Project>
